# Configure only in the verified existing SAICRM Vercel project.
# Provider connection URL must include sslmode=verify-full.
DATABASE_URL=
# Exact HTTPS origin, no trailing slash. Use a separate DB and origin for preview.
APP_ORIGIN=https://saicrm.vercel.app
RESEND_API_KEY=
EMAIL_FROM=
# Generate at least 32 random bytes, encoded as hex; server-only.
TOKEN_SECRET=
# For the operator bootstrap script only, not browser configuration.
BOOTSTRAP_ADMIN_EMAIL=admin@satguruai.com
