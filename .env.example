# Configure only in the verified existing SAICRM Vercel project.
# Provider connection URL must include sslmode=verify-full.
DATABASE_URL=
# Exact HTTPS origin, no trailing slash. Use a separate DB and origin for preview.
APP_ORIGIN=https://saicrm.vercel.app
# Google Workspace mailbox SMTP with a Google app password. No Resend key is needed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@satguruai.com
SMTP_PASSWORD=
EMAIL_FROM=SCRM <noreply@satguruai.com>
# Generate at least 32 random bytes, encoded as hex; server-only.
TOKEN_SECRET=
# For the operator bootstrap script only, not browser configuration.
BOOTSTRAP_ADMIN_EMAIL=admin@satguruai.com

# Optional Google SSO. Leave both absent until OAuth consent/client configuration is ready.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional verified Workspace hosted-domain restriction (signed hd claim).
GOOGLE_WORKSPACE_DOMAIN=

# Private bearer token for Vercel scheduled transfer maintenance (production only).
# Set a random value of at least 32 characters in Vercel; never expose it in client code.
CRON_SECRET=
